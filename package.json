{
  "name": "@alexcatdad/browser-ocr",
  "version": "0.1.1",
  "description": "Browser-local configurable OCR, image and PDF processing with self-hosted assets",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcatdad/browser-ocr.git"
  },
  "files": [
    "lib/",
    "runtime-assets/",
    "bin/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./assets": "./bin/assets.mjs",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "sideEffects": false,
  "bin": {
    "browser-ocr-assets": "./bin/copy-assets.mjs"
  },
  "dependencies": {
    "tesseract.js": "7.0.0",
    "pdfjs-dist": "6.3.289"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && vite build && tsc -p tsconfig.lib.json && node scripts/finish-library.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "verify": "npm test && npm run typecheck && npm run test:package",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.2"
  }
}
